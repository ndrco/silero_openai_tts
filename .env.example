HOST=0.0.0.0
PORT=8000

# Russian model
SILERO_LANGUAGE=ru
SILERO_MODEL_ID=v5_1_ru
SILERO_SAMPLE_RATE=48000
SILERO_DEVICE=auto
SILERO_NUM_THREADS=4
SILERO_MAX_CHARS_PER_CHUNK=500
SILERO_PAUSE_BETWEEN_FRAGMENTS_SEC=0.3
SILERO_DEFAULT_SPEAKER=kseniya

# English model (when LANGUAGE_AWARE_ROUTING=true)
SILERO_EN_ENABLED=true
SILERO_EN_LANGUAGE=en
SILERO_EN_MODEL_ID=v3_en
SILERO_EN_SAMPLE_RATE=48000
SILERO_EN_DEFAULT_SPEAKER=en_21

# Persistent directory for models/torch.hub cache
SILERO_MODELS_DIR=models

# Authentication
REQUIRE_AUTH=false
API_KEY=dummy-local-key

# Cache (cleared when the server stops)
CACHE_DIR=.cache_tts
CACHE_MAX_FILES=2000

# Audio playback (requires ffplay)
FFMPEG_BIN=ffmpeg
FFPLAY_BIN=ffplay
AUTO_PLAY=false  # if true, synthesized audio is automatically played through the server's default audio output device (requires ffplay)
AUTO_PLAY_VOLUME=1.0  # auto-play volume (1.0 = 100%, can be 0.5-2.0)
AUTO_PLAY_SHOW_SKIP_WINDOW=true  # show local Tkinter window with "Skip" button while playback is active
FORCE_PLAY=false  # force-enable audio playback (CLI override, also enables text output)
SHOW_TEXT=false  # print text to console before synthesis (CLI override)

# Latin → Cyrillic transliteration for pronouncing English words (hello → хелло)
TRANSLITERATE_LATIN=true

# Language-aware routing: RU and EN segments use different models
LANGUAGE_AWARE_ROUTING=false

